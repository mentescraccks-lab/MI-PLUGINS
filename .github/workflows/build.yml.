name: Build VST3 (Windows)

on:
  push:
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Configurar
        run: cmake -S MI-PLUGINS_listo -B build -G "Visual Studio 17 2022" -A x64

      - name: Compilar
        run: cmake --build build --config Release

      - name: Subir el VST3
        uses: actions/upload-artifact@v4
        with:
          name: LoudnessAnalyzer-VST3-Windows
          path: build/LoudnessAnalyzer_artefacts/Release/VST3/
